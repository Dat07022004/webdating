# Copy this file to .env.production on the EC2 host and fill real values.
# Do not commit .env.production.

# Backend image pushed to Amazon ECR.
BACKEND_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/webdating-backend:latest

# Public API port exposed on EC2 for Postman tests.
BACKEND_PUBLIC_PORT=3000
PORT=3000

# MongoDB container settings.
MONGO_INITDB_ROOT_USERNAME=webdating_admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_DATABASE=webdating
DATABASE_URL=mongodb://webdating_admin:replace-with-a-long-random-password@mongodb:27017/webdating?authSource=admin

# CORS and public URLs. Keep the EC2 public IP/DNS while backend-only testing.
ALLOWED_ORIGINS=*
FRONTEND_URL=
API_BASE_URL=http://EC2_PUBLIC_IP_OR_DNS:3000

# Clerk.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional integrations. Leave blank if not needed for the Postman flow being tested.
INNGEST_SIGNING_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# MongoDB backup to S3.
BACKUP_S3_URI=s3://your-backup-bucket/webdating/mongodb
BACKUP_RETENTION_DAYS=7
