# Backend runtime variables for AWS EC2 + Amazon DocumentDB.
# Copy these values into AWS Systems Manager Parameter Store or Secrets Manager.

NODE_ENV=production
PORT=3000

# Use the DocumentDB cluster endpoint, not an instance endpoint.
# URL-encode special characters in the username or password.
# Keep retryWrites=false because Amazon DocumentDB does not support retryable writes.
DATABASE_URL=mongodb://<DOCDB_USERNAME>:<URL_ENCODED_DOCDB_PASSWORD>@<DOCDB_CLUSTER_ENDPOINT>:27017/webdating?tls=true&tlsCAFile=/etc/docdb/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Comma-separated origins. Keep localhost only for temporary smoke tests.
ALLOWED_ORIGINS=https://<future-frontend-domain>
FRONTEND_URL=https://<future-frontend-domain>
API_BASE_URL=https://<backend-alb-domain>

CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

INNGEST_SIGNING_KEY=signkey_xxx

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

MOMO_PARTNER_CODE=<momo-partner-code>
MOMO_ACCESS_KEY=<momo-access-key>
MOMO_SECRET_KEY=<momo-secret-key>
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
